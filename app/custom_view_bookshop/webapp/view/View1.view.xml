<mvc:View controllerName="customviewbookshop.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

        <tnt:ToolHeader id="shellLikeToolHeader" class="sapUiTinyMargin">
            <Button id="_IDGenButton2" icon="sap-icon://menu2" type="Transparent" tooltip="Menu" press=".onCollapseExpandPress">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData" priority="NeverOverflow"/>
                </layoutData>
            </Button>
            <Image id="_IDGenImage" src="test-resources/sap/tnt/images/SAP_Logo.png" decorative="false" press="onLogoPressed" tooltip="SAP Logo" width="60px" height="30px">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData1" priority="NeverOverflow"/>
                </layoutData>
            </Image>
            <Title text="Prоduct Name" wrapping="false" id="productName">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData2" priority="Disappear"/>
                </layoutData>
            </Title>
            <Text text="Second title" wrapping="false" id="secondTitle">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData3" priority="Disappear"/>
                </layoutData>
            </Text>
            <ToolbarSpacer id="_IDGenToolbarSpacer" />
            <SearchField width="25rem" id="searchField">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData4" priority="Low" group="1"/>
                </layoutData>
            </SearchField>
            <Button visible="false" icon="sap-icon://search" type="Transparent" id="searchButton" tooltip="Search"/>
            <OverflowToolbarButton id="_IDGenOverflowToolbarButton" icon="sap-icon://da" type="Transparent" tooltip="Joule" text="Joule">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData5" group="2"/>
                </layoutData>
            </OverflowToolbarButton>
            <OverflowToolbarButton id="_IDGenOverflowToolbarButton1" icon="sap-icon://source-code" type="Transparent" tooltip="Action 1" text="Action 1">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData6" group="2"/>
                </layoutData>
            </OverflowToolbarButton>
            <OverflowToolbarButton id="_IDGenOverflowToolbarButton2" icon="sap-icon://card" type="Transparent" tooltip="Action 2" text="Action 2">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData7" group="2"/>
                </layoutData>
            </OverflowToolbarButton>
            <OverflowToolbarButton id="_IDGenOverflowToolbarButton3" icon="sap-icon://action-settings" type="Transparent" text="Settings"/>
            <Button id="_IDGenButton3" icon="sap-icon://bell" type="Transparent" tooltip="Notification">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData8" priority="NeverOverflow"/>
                </layoutData>
            </Button>
            <tnt:ToolHeaderUtilitySeparator id="_IDGenToolHeaderUtilitySeparator"/>
            <OverflowToolbarButton id="_IDGenOverflowToolbarButton4" icon="sap-icon://grid" type="Transparent" text="My Products" tooltip="My Products"/>
            <Avatar id="_IDGenAvatar" src="test-resources/sap/tnt/images/Woman_avatar_01.png" displaySize="XS" press=".onAvatarPressed" tooltip="Profile">
                <layoutData>
                    <OverflowToolbarLayoutData id="_IDGenOverflowToolbarLayoutData9" priority="NeverOverflow"/>
                </layoutData>
            </Avatar>
        </tnt:ToolHeader>

        <HBox id="_IDGenHBox3">
            <!-- Side Navigation -->
            <VBox id="_IDGenVBox8">
                <tnt:SideNavigation id="sideNavigation" selectedKey="walked" expanded="true">
                    <tnt:NavigationList id="_IDGenNavigationList1">
                        <tnt:NavigationListItem id="_IDGenNavigationListItem" text="Home" icon="sap-icon://home" />
                        <tnt:NavigationListGroup id="_IDGenNavigationListGroup" text="New">
                            <tnt:NavigationListItem id="_IDGenNavigationListItem1" text="Add Book" icon="sap-icon://people-connected" press=".onAddBookPressed" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem2" text="Building" icon="sap-icon://building">
                                <tnt:NavigationListItem id="_IDGenNavigationListItem3" text="Office 01" />
                                <tnt:NavigationListItem id="_IDGenNavigationListItem4" text="Office 02" />
                            </tnt:NavigationListItem>
                            <tnt:NavigationListItem id="_IDGenNavigationListItem5" text="Mileage" icon="sap-icon://mileage">
                                <tnt:NavigationListItem id="_IDGenNavigationListItem6" text="Driven" />
                                <tnt:NavigationListItem text="Walked" id="walked" />
                            </tnt:NavigationListItem>
                        </tnt:NavigationListGroup>
                        <tnt:NavigationListGroup id="_IDGenNavigationListGroup1" text="Recently used">
                            <tnt:NavigationListItem id="_IDGenNavigationListItem7" text="View Book Details" icon="sap-icon://kpi-managing-my-area" press=".onViewBookDetails" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem8" text="Flight" icon="sap-icon://flight" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem9" text="Map" icon="sap-icon://map-2" />
                        </tnt:NavigationListGroup>
                        <tnt:NavigationListGroup id="_IDGenNavigationListGroup2" text="Restricted" enabled="false">
                            <tnt:NavigationListItem id="_IDGenNavigationListItem10" text="Running" icon="sap-icon://physical-activity" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem11" text="Scissors" icon="sap-icon://scissors" />
                        </tnt:NavigationListGroup>
                        <tnt:NavigationListItem id="_IDGenNavigationListItem12" text="Transport" icon="sap-icon://passenger-train" />
                    </tnt:NavigationList>
                    <tnt:fixedItem>
                        <tnt:NavigationList id="_IDGenNavigationList2">
                            <tnt:NavigationListItem id="_IDGenNavigationListItem13" text="Bar Chart" icon="sap-icon://bar-chart" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem14" selectable="false" href="https://sap.com" target="_blank" text="External Link" icon="sap-icon://attachment" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem15" selectable="false" href="https://sap.com" target="_top" text="External Link _top" icon="sap-icon://attachment" />
                            <tnt:NavigationListItem id="_IDGenNavigationListItem16" text="Compare" icon="sap-icon://compare" />
                        </tnt:NavigationList>
                    </tnt:fixedItem>
                </tnt:SideNavigation>
            </VBox>
            <!-- Input Fields -->
            <Panel id="panel1" class="sapUiResponsiveMargin" width="60rem" visible="false" accessibleRole="Region">
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar">
                        <Title id="_IDGenTitle" text="Add New Book"/>
                    </OverflowToolbar>
                </headerToolbar>
                <VBox id="_IDGenVBox7">
                    <Breadcrumbs id="_IDGenBreadcrumbs" currentLocationText="Add New Item">
                        <Link id="_IDGenLink" text="Master"></Link>
                    </Breadcrumbs>
                    <HBox id="_IDGenHBox1">
                        <VBox id="_IDvbox">
                            <Label id="_labeled" text="ID" visible="true" />
                            <Input placeholder="Enter your title" id="id" visible="true"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox">
                            <Label id="_IDGenLabel" text="Title"/>
                            <Input placeholder="Enter your title" id="title"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox1">
                            <Label id="_IDGenLabel1" text="Author"/>
                            <Input placeholder="Enter your title" id="author"></Input>
                        </VBox>
                    </HBox>
                    <HBox id="_IDGenHBox">
                        <VBox id="_IDGenVBox2">
                            <Label id="_IDGenLabel2" text="Price"/>
                            <Input placeholder="Enter your title" id="price"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox3">
                            <Label id="_IDGenLabel3" text="Stock"/>
                            <Input placeholder="Enter your title" id="stock"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox4">
                            <Label id="_IDGenLabel4" text="Location"/>
                            <Input placeholder="Enter your title" id="location"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox5">
                            <Label id="_IDGenLabel5" text="Genre" visible="false" />
                            <Input placeholder="Enter your title" id="genre" visible="false"></Input>
                        </VBox>
                    </HBox>
                    <HBox id="_IDGenHBox2">
                        <VBox id="_IDGenVBox6">
                            <Button id="_IDGenButton" text="Submit" press="submit"></Button>
                        </VBox>
                    </HBox>
                </VBox>
            </Panel>
            <Panel id="panel2" class="sapUiResponsiveMargin" width="60rem" visible="false" accessibleRole="Region">
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <Title id="_IDGenTitle1" text="Book Details"/>
                    </OverflowToolbar>
                </headerToolbar>
                <Table id="table" items="{/Book}">
                    <columns>
                        <Column id="_IDGenColumn1">
                            <Label id="_IDGenLabel6" text="ID"></Label>
                        </Column>
                        <Column id="_IDGenColumn2">
                            <Label id="_IDGenLabel7" text="Title"></Label>
                        </Column>
                        <Column id="_IDGenColumn3">
                            <Label id="_IDGenLabel8" text="Author"></Label>
                        </Column>
                        <Column id="_IDGenColumn4">
                            <Label id="_IDGenLabel9" text="Price"></Label>
                        </Column>
                        <Column id="_IDGenColumn5">
                            <Label id="_IDGenLabel10" text="Stock"></Label>
                        </Column>
                        <Column id="_IDGenColumn6">
                            <Label id="_IDGenLabel11" text="Location"></Label>
                        </Column>
                        <Column id="_IDGenColumn66">
                            <Label id="_IDGenLabel116" text="Action"></Label>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem">
                            <cells>
                                <Text id="_IDGenText" text="{Id}"></Text>
                                <Text id="_IDGenText1" text="{title}"></Text>
                                <Text id="_IDGenText2" text="{author}"></Text>
                                <Text id="_IDGenText3" text="{price}"></Text>
                                <Text id="_IDGenText4" text="{stock}"></Text>
                                <Text id="_IDGenText5" text="{location}"></Text>
                                <Button text="..." id="action" press=".onActionPressed($event)"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
            <Panel id="panel3" class="sapUiResponsiveMargin" width="60rem" visible="false" accessibleRole="Region">
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar11">
                        <Title id="_IDGenTitle11" text="Update Book"/>
                    </OverflowToolbar>
                </headerToolbar>
                <VBox id="_IDGenVBox77">
                    <Breadcrumbs id="_IDGenBreadcrumbs11" currentLocationText="Add New Item">
                        <Link id="_IDGenLink11" text="Master"></Link>
                    </Breadcrumbs>
                    <HBox id="_IDGenHBox11">
                        <VBox id="_IDvbox11">
                            <Label id="_labeled11" text="ID" visible="true" />
                            <Input placeholder="Enter your title" id="id1" visible="true"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox22">
                            <Label id="_IDGenLabel12" text="Title"/>
                            <Input placeholder="Enter your title" id="title1"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox11">
                            <Label id="_IDGenLabel111" text="Author"/>
                            <Input placeholder="Enter your title" id="author1"></Input>
                        </VBox>
                    </HBox>
                    <HBox id="_IDGenHBox112">
                        <VBox id="_IDGenVBox222">
                            <Label id="_IDGenLabel222" text="Price"/>
                            <Input placeholder="Enter your title" id="price1"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox33">
                            <Label id="_IDGenLabel333" text="Stock"/>
                            <Input placeholder="Enter your title" id="stock1"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox444">
                            <Label id="_IDGenLabel44" text="Location"/>
                            <Input placeholder="Enter your title" id="location1"></Input>
                        </VBox>
                        <VBox id="_IDGenVBox555">
                            <Label id="_IDGenLabel555" text="Genre" visible="false" />
                            <Input placeholder="Enter your title" id="genre1" visible="false"></Input>
                        </VBox>
                    </HBox>
                    <HBox id="_IDGenHBox222">
                        <VBox id="_IDGenVBox66">
                            <Button id="_IDGenButton1" text="Submit" press="updateItem"></Button>
                        </VBox>
                    </HBox>
                </VBox>
            </Panel>
        </HBox>
    </Page>
</mvc:View>