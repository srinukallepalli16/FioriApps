annotate studentbd.marks with @(UI: {

    FieldGroup #marks: {
        $Type: 'UI.FieldGroupType',
        Data: [
            { $Type: 'UI.DataField', Value: telugu },
            { $Type: 'UI.DataField', Value: hindi },
            { $Type: 'UI.DataField', Value: english },
            { $Type: 'UI.DataField', Value: maths },
            { $Type: 'UI.DataField', Value: science },
            { $Type: 'UI.DataField', Value: social }
        ]
    }
});
