<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core" xmlns:m="sap.suite.ui.microchart">

    <VBox id="vbox" class="sapUiSmallMargin">
        <!-- <Title id="title" text="{i18n>accountdetails}" level="H1"/> -->
        <HBox id="hbox">
            <Label text="{i18n>accNumber}" id="label" />
            <!-- class="sapUiSmallMarginEnd" -->
            <!-- Property Binding used in this fragment -->
            <Text text="{oBankDetails>/AccountDetails/AccountNum}" id="bankAccVal" class="sapUiSmallMarginBegin"/>
        </HBox>
        <HBox id="hbox2">
            <Label text="{i18n>accholdername}" id="accholdername" />
            <!-- class="sapUiSmallMarginEnd" -->
            <Text text="{oBankDetails>/AccountDetails/Name}" id="accholdrname" class="sapUiSmallMarginBegin"/>
        </HBox>
        <HBox id="hbox3">
            <Label text="{i18n>ifsccode}" id="idIFSC" />
            <!-- class="sapUiSmallMarginEnd" -->
            <Text text="{oBankDetails>/AccountDetails/IFSCCode}" id="ifsccode" class="sapUiSmallMarginBegin"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>