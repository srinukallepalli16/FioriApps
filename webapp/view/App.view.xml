<mvc:View controllerName="com.sap.mybankdetails.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  class="sapUiSizeCompact">
  <App id="app">
    <Page id="page" title="{i18n>title}">
      <headerContent>
        <Button id="demobutn" type="Neutral" text="{i18n>home}" />
      </headerContent>
      <content>
        <Panel id="panel">
          <Panel id="panel1" expandable="false" ></Panel>
          <!-- headerText="{i18n>accountdetails}" Header Text is removed -->
          <FlexBox id="flexbox" alignItems="Start" justifyContent="Start">
            <ToolbarSpacer id="toolbarspcae12r"/>
            <Avatar id="avatar" src="/images/profile1.jpg" backgroundColor="Accent1" active="false" displaySize="XL" showBorder="true" press="avatar" />
            <ToolbarSpacer width="1.5rem" id="toolbarspacer333"/>
            <VBox id="vbox32">
              <ToolbarSpacer id="toolbarspcaer"/>
              <core:Fragment id="fragmentid" type="XML" fragmentName="com.sap.mybankdetails.view.fragments.BankDetails"/>
              <ToolbarSpacer id="toolbar"/>
              <Button id="button" class="sapUiSmallMarginBegin" press="openbankdetails" type="Emphasized" text="{i18n>findMoreBtn}"/>
            </VBox>
          </FlexBox>
        </Panel>
        <ToolbarSpacer width="20rem" id="toolbarspacer3333"/>
        <core:Fragment id="carddetails" fragmentName="com.sap.mybankdetails.view.fragments.CardDetails"/>
      </content>
    </Page>
  </App>
</mvc:View>

