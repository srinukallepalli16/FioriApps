<mvc:View
    controllerName="com.zsalesmaterial.controller.Sales"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <Page id="_IDGenPage3" title="Sales Data" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Table id="salesTable" items="{/SalesData}" class="sapUiResponsiveMargin">
                <columns>
                    <Column id="_IDGenColumn7"><Text id="_IDGenText13" text="Sales Order"/></Column>
                    <Column id="_IDGenColumn8"><Text id="_IDGenText14" text="Creation Date"/></Column>
                    <Column id="_IDGenColumn9"><Text id="_IDGenText15" text="Sold-To Party"/></Column>
                    <Column id="_IDGenColumn10"><Text id="_IDGenText16" text="Net Value"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem2">
                        <cells>
                            <Text id="_IDGenText17" text="{SalesOrder}"/>
                            <Text id="_IDGenText18" text="{CreationDate}"/>
                            <Text id="_IDGenText19" text="{SoldToParty}"/>
                            <ObjectNumber id="_IDGenObjectNumber1" number="{NetValue}" unit="{Currency}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>