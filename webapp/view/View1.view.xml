<mvc:View controllerName="hrdata.controller.View1"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">

        <VBox id="_IDGenVBox" class="sapUiResponsiveMargin">

            <!-- 1. Employee Search Filter Bar (RESTORED FIXED) -->
            <Panel id="_IDGenSearchPanel" headerText="Search Employee" class="sapUiSmallMarginBottom">
                <HBox id="_IDGenHBox" alignItems="Center">
                    <Label id="_IDGenLabel1" text="Personnel Number (PERNR):" class="sapUiSmallMarginEnd" design="Bold"/>
                    <Input id="idPernrInput" placeholder="Enter Employee ID (e.g. 00000002)" width="250px" submit="onSearchEmployee"/>
                    <Button id="_IDGenButton" text="Search" type="Emphasized" icon="sap-icon://search" press="onSearchEmployee" class="sapUiTinyMarginBegin"/>
                </HBox>
            </Panel>

            <!-- 2. Dependent Selector Dropdown Box (CLEANED DUPLICATIONS) -->
            <Panel id="_IDGenPanel1" headerText="Select Family Member">
                <VBox id="_IDGenVBox1">
                    <Label id="_IDGenLabel2" text="Choose Dependent:" labelFor="idDepSelect" class="sapUiTinyMarginBottom" design="Bold"/>
                    <!-- Enabled handles natively in controller when data completes loading -->
                    <Select id="idDepSelect" change="onDependentChange" width="100%" maxWidth="400px" enabled="false">
                        <core:Item id="_IDGenItem" key="{Type}" text="{Zdependent} - {Type}" />
                    </Select>
                </VBox>
            </Panel>

            <!-- 3. Dynamic SimpleForm Layout using Grid Inputs -->
            <f:SimpleForm id="idSimpleForm" visible="false" editable="true" layout="ResponsiveGridLayout" columnsL="2" columnsM="2" class="sapUiMediumMarginTop">
                <f:content>
                    <Label id="_IDGenLabel3" text="Dependent Type" />
                    <Input id="_IDGenInput" value="{Zdependent}" editable="false" />

                    <Label id="_IDGenLabel4" text="Dependent Name" />
                    <Input id="_IDGenInput1" value="{DependentName}" editable="false" />

                    <Label id="_IDGenLabel5" text="Passport ID" />
                    <Input id="idPassportIdInput" value="{PassportId}" editable="true" />

                    <Label id="_IDGenLabel6" text="Passport ID Expiry Date" />
                    <DatePicker id="idPassportExpiryInput" value="{PassportExpiry}" editable="true" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy" change="onPassportExpiryChange" />

                    <Label id="_IDGenLabel7" text="Resident Permit" />
                    <Input id="idResidentPermitInput" value="{ResidentPermit}" editable="true" />

                    <Label id="_IDGenLabel8" text="Resident Permit Expiry Date" />
                    <DatePicker id="idResidentExpiryInput" value="{ResidentPermitExpiry}" editable="true" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy" change="onResidentExpiryChange" />
                </f:content>
            </f:SimpleForm>
            <Button id="_IDGenButton1" text="Submit" press="onSaveDependentDetails" ></Button>
        </VBox>
    </Page>
</mvc:View>
