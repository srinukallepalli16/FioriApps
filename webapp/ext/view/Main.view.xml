<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:layout="sap.ui.layout" xmlns:macros="sap.fe.macros"
    xmlns:html="http://www.w3.org/1999/xhtml" controllerName="com.zsalesmaterial01.ext.view.Main">
 <Page id="_IDGenPage1" title="Dynamic Sales &amp; Material Report">
        <content>
            <!-- 1. Freestyle Radio Buttons -->
            <Panel id="_IDGenPanel" class="sapUiResponsiveMargin" width="auto">
                <layout:VerticalLayout id="_IDGenVerticalLayout">
                    <RadioButtonGroup id="rbgSelection" select=".onRadioSelect">
                        <RadioButton id="_IDGenRadioButton" text="Sales" />
                        <RadioButton id="_IDGenRadioButton1" text="Material" />
                    </RadioButtonGroup>
                </layout:VerticalLayout>
            </Panel>

            <!-- 2. SALES Building Blocks (Visible by Default) -->
            <VBox id="salesContainer" visible="true" class="sapUiResponsiveMargin">
                <!-- Auto-generates the Smart Filter Bar from RAP @UI.selectionField -->
                <macros:FilterBar id="salesFilterBar" metaPath="/SalesData/@com.sap.vocabularies.UI.v1.SelectionFields" />
                
                <!-- Auto-generates the Smart Table from RAP @UI.lineItem -->
                <macros:Table id="salesTable" metaPath="/SalesData/@com.sap.vocabularies.UI.v1.LineItem" filterBar="salesFilterBar" />
            </VBox>

            <!-- 3. MATERIAL Building Blocks (Hidden by Default) -->
            <VBox id="materialContainer" visible="false" class="sapUiResponsiveMargin">
                <!-- Auto-generates the Smart Filter Bar from RAP @UI.selectionField -->
                <macros:FilterBar id="matFilterBar" metaPath="/MaterialData/@com.sap.vocabularies.UI.v1.SelectionFields" />
                
                <!-- Auto-generates the Smart Table from RAP @UI.lineItem -->
                <macros:Table id="matTable" metaPath="/MaterialData/@com.sap.vocabularies.UI.v1.LineItem" filterBar="matFilterBar" />
            </VBox>
        </content>
    </Page>
</mvc:View>