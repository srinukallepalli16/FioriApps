<mvc:View controllerName="com.app.managerui.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
        <SplitContainer id="splitcontainer">
            <masterPages>
                <Page id="masterpage" title="Employee Details">
                    <List id="employeesdetails" items="{/Employees}">
                        <StandardListItem id="standardlist" title="{name}"></StandardListItem>
                    </List>
                </Page>
            </masterPages>
            <detailPages>
                <Page id="detailpage" title="Manager Product Support Mapping">
                    <VBox id="_IDGenVBox1">
                        <Table id="employeeTable" items="{/Employees}">
                            <columns>
                                <Column id="_IDGenColumn">
                                    <Text id="_IDGenText" text="Employee Name" />
                                </Column>
                                <Column id="_IDGenColumn1">
                                    <Text id="_IDGenText1" text="Salesforce" />
                                </Column>
                                <Column id="_IDGenColumn2">
                                    <Text id="_IDGenText2" text="SAP" />
                                </Column>
                                <Column id="_IDGenColumn3">
                                    <Text id="_IDGenText3" text="Oracle" />
                                </Column>
                                <Column id="_IDGenColumn4">
                                    <Text id="_IDGenText4" text="Action" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem id="_IDGenColumnListItem">
                                    <Text id="_IDGenText5" text="{name}" />
                                    <CheckBox id="_IDGenCheckBox" selected="{= ${products}.includes('PRD01') }" select="onToggleProduct" customData="{employeeId: {path: 'ID'}, productCode: 'PRD01'}" />
                                    <CheckBox id="_IDGenCheckBox1" selected="{= ${products}.includes('PRD02') }" select="onToggleProduct" customData="{employeeId: {path: 'ID'}, productCode: 'PRD02'}" />
                                    <CheckBox id="_IDGenCheckBox2" selected="{= ${products}.includes('PRD03') }" select="onToggleProduct" customData="{employeeId: {path: 'ID'}, productCode: 'PRD03'}" />
                                    <Button id="_IDGenButton" text="Save" press="onSaveEmployee">
                                        <customData>
                                            <core:CustomData key="employeeId" value="{ID}" writeToDom="false" />
                                        </customData>
                                    </Button>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Button id="_IDGenButton1" text="Save All" press="onSaveAll" class="sapUiSmallMarginTop"/>
                    </VBox>
                </Page>
            </detailPages>
        </SplitContainer>
    </Page>
</mvc:View>